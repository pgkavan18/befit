# Supabase / PostgreSQL Database Connection
# Replace with your Supabase DB password and project host
DB_URL=jdbc:postgresql://db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASS=your-supabase-db-password

# Hibernate Schema Validation (validate for production, update for local dev)
DDL_AUTO=validate

# JWT Secret (Must be a secure 256-bit base64-encoded secret for production)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_256_BITS_CHANGE_IN_PRODUCTION
JWT_EXPIRATION=86400000

# Allowed CORS Origins (Comma-separated URLs of your deployed frontend)
# Example: ALLOWED_ORIGINS=https://befit.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
