# ==========================================
# Root .gitignore for Fitness Project
# ==========================================

# IDE Configurations & Local Workspace Data
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# Local Secrets & Credentials (NEVER COMMIT)
*.local.properties
*local.properties
application-local.properties
.env
.env.*
.env.local

# Build Artifacts
**/target/
**/dist/
**/dist-ssr/

# Dependency & Runtime Directories
**/node_modules/
**/.node/

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
